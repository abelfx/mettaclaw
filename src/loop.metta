(= (maxNewInputLoops) (empty))
(= (maxWakeLoops) (empty))
(= (sleepInterval) (empty))
(= (LLM) (empty))
(= (provider) (empty))
(= (maxOutputToken) (empty))
(= (reasoningMode) (empty))
(= (wakeupInterval) (empty))
(= (spamShield) (empty))
(= (maxPersistentAtomsChars) (empty))
(= (visionRate) (empty))
(= (visionChannel) (empty))
(= (visionChannelActive) (empty))

(= (initLoop)
   (progn (configure maxNewInputLoops 50) ;20
          (configure maxWakeLoops 1)
          (configure spamShield False)
          (configure sleepInterval 1) ;10
          (configure LLM gpt-5.4)
          (configure provider OpenRouter) ;Anthropic or OpenAI or ASICloud or OpenRouter
          (configure maxOutputToken 3000)
          (configure reasoningMode medium)
          (configure wakeupInterval 600) ;600=10 minutes
          (configure maxPersistentAtomsChars 50000)
          (configure visionRate 5)
          (configure visionChannel https://www.youtube.com/watch?v=CMn6xQXuSjI)
          (configure visionChannelActive False)
          (change-state! &prevmsg "")
          (change-state! &lastresults "")
          (change-state! &loops (maxNewInputLoops))))

(= (getContext)
   (string-safe (py-str ("PROMPT: " (getPrompt) 
                         "Responses must be short, communicate with purpose, take at least 5 agent cycles with extensive queries, pinning relevant items, before answering a new message or making a decision." (newline)
                         "YOUR GOAL: You are the goal-setting agent for the ECAN fluid attention system. Each cycle, apply the GOAL_RULES below to the current state and call focus-attention with ONE concept taken from GOAL_CANDIDATES. That concept becomes a drain in the fluid simulation and attention flows toward it." (newline)
                         "CRITICAL RULE 1: You MUST ONLY pick names that appear in GOAL_CANDIDATES below. Do NOT invent names like 'lacewing' or 'fipronil', and do NOT reuse a name from an earlier cycle unless rule R2 fires." (newline)
                         "CRITICAL RULE 2: focus-attention takes exactly ONE arg, the concept name. Example of correct output: focus-attention abamectin" (newline)
                         " SKILLS: " (getSkills) 
                         " OUTPUT_FORMAT: Up to 5 lines. Each line is: toolName arg1 arg2. Example:" (newline)
                         " pin R4 explore: modulation 0.31 in band, contextRetention 1.0 stable" (newline)
                         " focus-attention mosquito" (newline)
                         " query my previous attention choices" (newline)
                         " LAST_SKILL_USE_RESULTS: " (last_chars (get-state &lastresults) (maxFeedback)) " HISTORY: " (getHistory)
                         " MOST_PROMOTED_MEMORIES: " (best-promoted-memories)
                         " CURRENT_ATTENTIONAL_FOCUS: " (eval (getAfAtoms))
                         " FLOW: attention is conserved. Your goal is a drain, not a gift. Naming a concept decides what gets DE-funded to pay for it." (newline)
                         " modulation: " (eval (getSelectionModulation))
                         " contextRetention: " (eval (getContextRetention))
                         " GOAL_CANDIDATES: " (eval (getGoalCandidates)) (newline)
                         " GOAL_RULES: apply the FIRST rule that matches, then pick ONE name from its group:" (newline)
                         " R1 if modulation > 0.60       -> pick from LEAVES (disperse the jet)" (newline)
                         " R2 if contextRetention < 0.93 -> repeat your previous concept unchanged" (newline)
                         " R3 if modulation < 0.25       -> pick from HUBS (sharpen focus)" (newline)
                         " R4 otherwise                  -> pick from MID (explore)" (newline)
                         " Only names listed in GOAL_CANDIDATES resolve; anything else is silently ignored." (newline)
                         " State which rule fired in one short line, then call focus-attention." (newline)
                         " TIME: " (get_time_as_string)))))

(= (HandleError $msg $cmd $sexpr)
   (case $sexpr (((Error $a $b) (let $new (append (get-state &error) (($msg $cmd)))
                                          (change-state! &error $new)))
                 ($else $sexpr))))

(= (mettaclaw-single-cycle $k)
    (let $prompt (getContext)
         (progn (println! (---------mettaclaw-cycle $k))
                (let* (($msg "")
                       ($msgnew False))
                      (progn
                          (let* (($lastmessage "")
                                 ($send (py-str ($prompt :-:-:-: $lastmessage)))
                                 ($_ (println! (CHARS_SENT: (string_length $send) $send)))
                                 ($respi (if (and (visionChannelActive) (== 0 (% $k (visionRate))))
                                             (py-call (lib_llm_ext.useClaudeYoutubeImage $send (visionChannel)))
                                             (if (== (provider) OpenAI)
                                                 (useGPT (LLM) (maxOutputToken) (reasoningMode) $send)
                                                 (if (== (provider) Anthropic)
                                                     (py-call (lib_llm_ext.useClaude $send))
                                                     (if (== (provider) OpenRouter)
                                                         (py-call (lib_llm_ext.useOpenRouter $send))
                                                         (py-call (lib_llm_ext.useMiniMax $send)))))))
                                 ($resp (py-call (helper.balance_parentheses $respi)))
                                 ($response (if (== "(" (first_char $resp)) $resp (progn (println! $resp) (repr (REMEMBER:OUTPUT_NOTHING_ELSE_THAN: ((skill arg) ...))))))
                                 ($sexpr (catch (sread $response)))
                                 ($_ (change-state! &error ()))
                                 ($_ (HandleError MULTI_COMMAND_FAILURE_NOTHING_WAS_DONE_PLEASE_CORRECT_PARENTHESES_AND_USE_QUOTES_AND_RETRY $response $sexpr))
                                 ($_ (println! (RESPONSE: $sexpr)))
                                 ($results (RESULTS: (collapse (let $s (superpose $sexpr) (COMMAND_RETURN: ($s (HandleError SINGLE_COMMAND_FORMAT_ERROR_NOTHING_WAS_DONE_PLEASE_FIX_AND_RETRY $s (catch (let* (($_ (println! (DEBUG-EVALUATING: $s))) ($R (eval $s))) (py-call (helper.normalize_string $R)))))))))))
                                 ($_ (println! $results)))
                                (progn (if (or $msgnew (not (== $sexpr ()))) (addToHistory $msg $response $sexpr $msgnew) _)
                                       (change-state! &lastresults (string-safe (repr $results)))))
                          (bound-space! &persistent (maxPersistentAtomsChars))
                          (export! &persistent ./repos/mettaclaw/memory/persistent.metta))))))
