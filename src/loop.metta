(= (maxNewInputLoops) (empty))
(= (maxWakeLoops) (empty))
(= (sleepInterval) (empty))
(= (LLM) (empty))
(= (provider) (empty))
(= (maxOutputToken) (empty))
(= (reasoningMode) (empty))
(= (wakeupInterval) (empty))
(= (spamShield) (empty))
(= (maxPersistentAtomsChars) (empty))
(= (visionRate) (empty))
(= (visionChannel) (empty))
(= (visionChannelActive) (empty))

; Free-run: high loop count + short wake so goals refresh while ECAN runs.
(= (initLoop)
   (progn (configure maxNewInputLoops 100000)
          (configure maxWakeLoops 1)
          (configure spamShield False)
          (configure sleepInterval 1)
          (configure LLM openai/gpt-oss-20b:free)
          (configure provider OpenRouter)
          (configure maxOutputToken 3000)
          (configure reasoningMode medium)
          (configure wakeupInterval 5)
          (configure maxPersistentAtomsChars 50000)
          (configure visionRate 5)
          (configure visionChannel https://www.youtube.com/watch?v=CMn6xQXuSjI)
          (configure visionChannelActive False)
          (change-state! &prevmsg "")
          (change-state! &lastresults "")
          (change-state! &loops (maxNewInputLoops))))

(= (getContext)
   (string-safe (py-str ("PROMPT: " (getPrompt)
                         "YOUR GOAL: You are the goal-setting agent for the ECAN fluid attention system. Each cycle, apply GOAL_RULES and call focus-attention with ONE bare concept from GOAL_CANDIDATES. That concept becomes a drain; attention flows toward it." (newline)
                         "CRITICAL RULE 1: ONLY pick a name that appears in GOAL_CANDIDATES. Strip any :score / :naf / :dN suffix — emit the bare name only (peaweevils not peaweevils:152)." (newline)
                         "CRITICAL RULE 2: focus-attention takes exactly ONE arg. Correct example: focus-attention abamectin" (newline)
                         "CRITICAL RULE 3: Decide THIS cycle. Do not echo LAST_SKILL_USE_RESULTS, HISTORY, or other prompt fields into args." (newline)
                         " SKILLS: pin string | focus-attention concept" (newline)
                         " LAST_SKILL_USE_RESULTS: " (last_chars (get-state &lastresults) 2000)
                         " CURRENT_ATTENTIONAL_FOCUS: " (eval (getAfAtoms))
                         " FLOW: attention is conserved. A goal is a drain, not a gift." (newline)
                         " modulation: " (eval (getSelectionModulation))
                         " contextRetention: " (eval (getContextRetentionBatch))
                         " GOAL_CANDIDATES: " (eval (getGoalCandidates)) (newline)
                         " GOAL_RULES: apply the FIRST matching rule, then pick ONE bare name from that group:" (newline)
                         " R1 if modulation > 0.60       -> BREAK   (disperse a jet far away)" (newline)
                         " R2 if contextRetention < 0.70 -> SETTLE  (fund a starved AF member)" (newline)
                         " R3 if modulation < 0.25       -> SHARPEN (concentrate on best-funded AF)" (newline)
                         " R4 otherwise                  -> EXPAND  (grow the frontier one step)" (newline)
                         " TIME: " (get_time_as_string) (newline)
                         " OUTPUT_FORMAT: emit exactly two lines then STOP. Do not echo any fields above." (newline)
                         " pin R3 sharpen" (newline)
                         " focus-attention mosquito"))))

(= (HandleError $msg $cmd $sexpr)
   (case $sexpr (((Error $a $b) (let $new (append (get-state &error) (($msg $cmd)))
                                          (change-state! &error $new)))
                 ($else $sexpr))))

(= (mettaclaw)
   (mettaclaw 1))
(= (mettaclaw $k)
   (progn (if (== $k 1) (progn (initLoop)
                               (initMemory)
                               (initChannels))
                        (change-state! &loops (- (get-state &loops) 1)))
          (let $prompt (getContext)
               (progn (println! (---------iteration $k))
                      (let* (($msgrcv (string-safe (repr (receive))))
                             ($msgnew (prog1 (and (> (string_length $msgrcv) 0) (!= $msgrcv (get-state &prevmsg)))
                                             (if (> (string_length $msgrcv) 0) (change-state! &prevmsg $msgrcv) _)))
                             ($msg (get-state &prevmsg))
                             ($_ (if (and (> $k 1) $msgnew)
                                     (change-state! &loops (maxNewInputLoops)) _)))
                            (if (> (get-state &loops) 0)
                                (let* (($lastmessage (if $msgnew (HUMAN-MSG: $msg) (if (spamShield) " DO NOT RE-SEND OR SPAM!" "")))
                                       ($_ (change-state! &nextWakeAt (+ (get_time) (wakeupInterval))))
                                       ($_ (println! $lastmessage))
                                       ($send (py-str ($prompt :-:-:-: $lastmessage)))
                                       ($_ (println! (CHARS_SENT: (string_length $send) $send)))
                                       ($respi (if (and (visionChannelActive) (== 0 (% $k (visionRate))))
                                                   (py-call (lib_llm_ext.useClaudeYoutubeImage $send (visionChannel)))
                                                   (if (== (provider) OpenAI)
                                                       (useGPT (LLM) (maxOutputToken) (reasoningMode) $send)
                                                       (if (== (provider) Anthropic)
                                                           (py-call (lib_llm_ext.useClaude $send))
                                                           (if (== (provider) OpenRouter)
                                                               (py-call (lib_llm_ext.useOpenRouter $send))
                                                               (py-call (lib_llm_ext.useMiniMax $send)))))))
                                       ($resp (py-call (helper.balance_parentheses $respi)))
                                       ($response (if (== "(" (first_char $resp)) $resp (progn (println! $resp) (repr (REMEMBER:OUTPUT_NOTHING_ELSE_THAN: ((skill arg) ...))))))
                                       ($sexpr (catch (sread $response)))
                                       ($_ (change-state! &error ()))
                                       ($_ (HandleError MULTI_COMMAND_FAILURE_NOTHING_WAS_DONE_PLEASE_CORRECT_PARENTHESES_AND_USE_QUOTES_AND_RETRY $response $sexpr))
                                       ($_ (println! (RESPONSE: $sexpr)))
                                       ($results (RESULTS: (collapse (let $s (superpose $sexpr) (COMMAND_RETURN: ($s (HandleError SINGLE_COMMAND_FORMAT_ERROR_NOTHING_WAS_DONE_PLEASE_FIX_AND_RETRY $s (catch (let $R (eval $s) (py-call (helper.normalize_string $R)))))))))))
                                       ($_ (println! $results)))
                                      (progn (if (or $msgnew  (not (== $sexpr ()))) (addToHistory $msg $response $sexpr $msgnew) _)
                                             (change-state! &lastresults (string-safe (repr $results)))))
                                (if (> (get_time) (get-state &nextWakeAt))
                                    (change-state! &loops (+ 1 (maxWakeLoops))) _)))
                      (bound-space! &persistent (maxPersistentAtomsChars))
                      (export! &persistent ./repos/mettaclaw/memory/persistent.metta)
                      (sleep (sleepInterval))
                      (cut)
                      (gc)
                      (mettaclaw (+ 1 $k))))))
                      